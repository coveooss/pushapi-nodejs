{
  "name": "coveo-pushapi-cli",
  "version": "3.0.1",
  "description": "Command line tool to push JSON payloads to the Coveo Cloud using the PushAPI",
  "type": "module",
  "main": "push.js",
  "exports": "./push.js",
  "bin": {
    "pushapi": "client-global.js"
  },
  "files": [
    "client-global.js",
    "push.js",
    "src/*.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "prepack": "npm run lint && npm test"
  },
  "keywords": [
    "coveo",
    "cloud",
    "push",
    "pushapi",
    "json"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coveooss/pushapi-nodejs.git"
  },
  "author": "Jerome Devost <jdevost@gmail.com> (https://github.com/jdevost)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/coveooss/pushapi-nodejs/issues"
  },
  "homepage": "https://github.com/coveooss/pushapi-nodejs#readme"
}
